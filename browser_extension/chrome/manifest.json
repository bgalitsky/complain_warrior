{
  "manifest_version": 3,
  "name": "Complaint Warrior Form Assistant",
  "version": "0.2.2",
  "description": "Click to fill known blank form fields from your selected CW complaint. Review on the website.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "CW: automatically fill this form"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
